local function setupPageLayout(page)
	page.AutomaticCanvasSize = Enum.AutomaticSize.Y
	page.ScrollBarThickness = 4

	local padding = page:FindFirstChildOfClass("UIPadding") or Instance.new("UIPadding", page)
	padding.PaddingTop = UDim.new(0, 10)
	padding.PaddingBottom = UDim.new(0, 10)
	padding.PaddingLeft = UDim.new(0, 10)
	padding.PaddingRight = UDim.new(0, 10)

	local layout = page:FindFirstChildOfClass("UIListLayout") or Instance.new("UIListLayout", page)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 10)
end

local function getOrCreatePage(pageName)
	local page = pageBackground:FindFirstChild(pageName)
	if not page then
		page = Instance.new("ScrollingFrame")
		page.Name = pageName
		page.Size = UDim2.new(1, 0, 1, 0)
		page.BackgroundTransparency = 1
		page.BorderSizePixel = 0
		page.Visible = false
		page.Parent = pageBackground
	end
	setupPageLayout(page)
	return page
end

