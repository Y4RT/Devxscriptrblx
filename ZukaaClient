local buttonOrder = 0
local function addCategoryButton(categoryName)
	local buttonName = categoryName .. "Button"
	local existingButton = scrollingFrame:FindFirstChild(buttonName)
	local targetPage = getOrCreatePage(categoryName .. "Page")

	if existingButton then
		return targetPage
	end

	buttonOrder = buttonOrder + 1
	local button = Instance.new("TextButton")
	button.Name = buttonName
	button.Size = UDim2.new(1, -10, 0, 35)
	button.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
	button.BorderSizePixel = 0
	button.Font = Enum.Font.Sarpanch
	button.RichText = true
	button.Text = "<b>" .. categoryName .. "</b>"
	button.TextColor3 = Color3.fromRGB(255, 255, 255)
	button.TextSize = 14
	button.LayoutOrder = buttonOrder
	button.Parent = scrollingFrame

	Instance.new("UICorner", button).CornerRadius = UDim.new(0, 6)

	button.MouseButton1Click:Connect(function()
		playClickSound()
		for _, page in ipairs(pageBackground:GetChildren()) do
			if page:IsA("GuiObject") then page.Visible = false end
		end
		targetPage.Visible = true
	end)

	return targetPage
end

