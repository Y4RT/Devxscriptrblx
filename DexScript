	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.new(1 / 3, -4, 0, 24)
	grid.CellPadding = UDim2.fromOffset(6, 6)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = holder
	local buttons = {}
	local function refresh()
		for name, b in pairs(buttons) do
			local on = Settings[key] == name
			b.button.BackgroundColor3 = on and Theme.Selected or Theme.Item
			b.stroke.Color = on and Theme.Accent or Theme.Stroke
			b.button.TextColor3 = Theme.Text
			if b.dot then
				b.dot.BackgroundColor3 = getSwatch(name)
			end
		end
	end
	for i, name in ipairs(options) do
		local btn = Instance.new("TextButton")
		btn.AutoButtonColor = false
		btn.BorderSizePixel = 0
		btn.Font = Theme.FontMedium
		btn.TextSize = 11
		btn.Text = name
		btn.LayoutOrder = i
		btn.TextTruncate = Enum.TextTruncate.AtEnd
		btn.Parent = holder
		sCorner(btn, 5)
		local st = sStroke(btn, nil, 0.2)
		local entry = { button = btn, stroke = st }
		if getSwatch then
			btn.TextXAlignment = Enum.TextXAlignment.Left
			local pad = Instance.new("UIPadding")
			pad.PaddingLeft = UDim.new(0, 18)
			pad.Parent = btn
			local dot = Instance.new("Frame")
			dot.BorderSizePixel = 0
			dot.AnchorPoint = Vector2.new(0, 0.5)
			dot.Position = UDim2.new(0, -11, 0.5, 0)
			dot.Size = UDim2.fromOffset(7, 7)
			dot.Parent = btn
			sCorner(dot, 4)
			entry.dot = dot
		end
		buttons[name] = entry
		btn.MouseButton1Click:Connect(function()
			Settings[key] = name
			refresh()
			saveSettings()
			if onChange then
				onChange(name)
			end
		end)
	end
	refresh()
	table.insert(settingsRefreshers, refresh)
end

--- click-to-rebind key
local listeningForKey = false
local function addKeybind(text, key)
	local r = newRow(26)
	rowLabel(r, text)
	local b = Instance.new("TextButton")
	b.AutoButtonColor = false
	b.BorderSizePixel = 0
	b.AnchorPoint = Vector2.new(1, 0.5)
	b.Position = UDim2.new(1, 0, 0.5, 0)
	b.Size = UDim2.fromOffset(96, 20)
	b.Font = Theme.FontMedium
	b.TextSize = 11
	b.Text = Settings[key]
	b.Parent = r
	bind(b, "BackgroundColor3", "Item")
	bind(b, "TextColor3", "Text")
	sCorner(b, 5)
	sStroke(b, "Stroke", 0.2)
	b.MouseButton1Click:Connect(function()
		if listeningForKey then
			return
		end
		listeningForKey = true
		b.Text = "Press a key..."
		local conn
		conn = UserInputService.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.Keyboard then
				return
			end
			conn:Disconnect()
			if input.KeyCode ~= Enum.KeyCode.Escape then
				Settings[key] = input.KeyCode.Name
				saveSettings()
			end
			b.Text = Settings[key]
			task.defer(function()
				listeningForKey = false
			end)
		end)
	end)
	table.insert(settingsRefreshers, function()
		b.Text = Settings[key]
	end)
end

local function addActionButton(text, onClick)
	local r = newRow(28)
	local b = Instance.new("TextButton")
	b.AutoButtonColor = false
	b.BorderSizePixel = 0
	b.Size = UDim2.new(1, 0, 1, 0)
	b.Font = Theme.FontMedium
	b.TextSize = 12
	b.Text = text
	b.Parent = r
	bind(b, "BackgroundColor3", "Item")
	bind(b, "TextColor3", "Text")
	sCorner(b, 6)
	sStroke(b, "Stroke", 0.2)
	b.MouseEnter:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.15), { BackgroundColor3 = Theme.ItemHover }):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.15), { BackgroundColor3 = Theme.Item }):Play()
	end)
	b.MouseButton1Click:Connect(onClick)
end

