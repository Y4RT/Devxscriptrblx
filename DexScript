--- copies a preset into the live Theme table (everything reads Theme.X, so tweens pick it up too)
local function loadThemePreset(name)
	local preset = ThemePresets[name] or ThemePresets.Midnight
	for key, rgb in pairs(preset) do
		Theme[key] = Color3.fromRGB(rgb[1], rgb[2], rgb[3])
	end
end
loadThemePreset(Settings.Theme)

--- things that get recoloured when the theme changes: { instance, property, themeKey }
local themeBindings = {}
local function bind(inst, prop, key)
	table.insert(themeBindings, { inst, prop, key })
	inst[prop] = Theme[key]
	return inst
end
--- panels that follow the Window opacity setting
local opacityTargets = {}

local function addCorner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 6)
	c.Parent = parent
	return c
end

local function addStroke(parent, color, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color or Theme.Stroke
	s.Thickness = 1
	s.Transparency = transparency or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

--- squares off a rounded corner where two panels meet
local function addFill(parent, size, position, themeKey)
	local f = Instance.new("Frame")
	f.Name = "CornerFill"
	bind(f, "BackgroundColor3", themeKey)
	table.insert(opacityTargets, f)
	f.BorderSizePixel = 0
	f.Size = size
	f.Position = position
	f.ZIndex = 1
	f.Parent = parent
	return f
end

