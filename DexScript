	valueLabel.Size = UDim2.new(0.35, 0, 0, 18)
	valueLabel.Font = Theme.FontMedium
	valueLabel.TextSize = 12
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right
	valueLabel.Parent = r
	bind(valueLabel, "TextColor3", "SubText")
	local track = Instance.new("Frame")
	track.BorderSizePixel = 0
	track.Position = UDim2.new(0, 0, 0, 26)
	track.Size = UDim2.new(1, 0, 0, 6)
	track.Parent = r
	bind(track, "BackgroundColor3", "Item")
	sCorner(track, 3)
	local fill = Instance.new("Frame")
	fill.BorderSizePixel = 0
	fill.Parent = track
	bind(fill, "BackgroundColor3", "Accent")
	sCorner(fill, 3)
	local knob = Instance.new("Frame")
	knob.BorderSizePixel = 0
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Size = UDim2.fromOffset(12, 12)
	knob.BackgroundColor3 = Color3.new(1, 1, 1)
	knob.ZIndex = 2
	knob.Parent = track
	sCorner(knob, 6)
	local hit = Instance.new("TextButton")
	hit.BackgroundTransparency = 1
	hit.Text = ""
	hit.Position = UDim2.new(0, -6, 0, 18)
	hit.Size = UDim2.new(1, 12, 0, 20)
	hit.ZIndex = 3
	hit.Parent = r

	local function refresh()
		local frac = math.clamp((Settings[key] - min) / (max - min), 0, 1)
		fill.Size = UDim2.new(frac, 0, 1, 0)
		knob.Position = UDim2.new(frac, 0, 0.5, 0)
		valueLabel.Text = fmt(Settings[key])
	end
	local function setFromX(x)
		local frac = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		local v = min + (max - min) * frac
		v = math.clamp(math.floor(v / step + 0.5) * step, min, max)
		v = tonumber(string.format("%.4f", v)) -- tidy float noise
		if v ~= Settings[key] then
			Settings[key] = v
			refresh()
			if onChange then
				onChange(v)
			end
		end
	end
	local dragging = false
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end)
	table.insert(
		connections,
		UserInputService.InputChanged:Connect(function(input)
			if
				dragging
				and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch)
			then
				setFromX(input.Position.X)
			end
		end)
	)
	table.insert(
		connections,
		UserInputService.InputEnded:Connect(function(input)
			if
				dragging
				and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch)
			then
				dragging = false
				saveSettings()
			end
		end)
	)
	refresh()
	table.insert(settingsRefreshers, refresh)
end

