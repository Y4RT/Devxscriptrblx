end

function applyTheme()
	for _, b in ipairs(themeBindings) do
		pcall(function()
			b[1][b[2]] = Theme[b[3]]
		end)
	end
	-- logged remotes + function buttons that were cloned before the change
	for _, v in ipairs(LogList:GetChildren()) do
		if v:IsA("Frame") and v:FindFirstChild("Button") then
			v.Button.BackgroundColor3 = (selected and selected.Log == v) and Theme.Selected or Theme.Item
			v.Text.TextColor3 = Theme.Text
		end
	end
	for _, v in ipairs(ScrollingFrame:GetChildren()) do
		if v:IsA("Frame") and v:FindFirstChild("Button") then
			v.Button.BackgroundColor3 = Theme.Item
			local st = v.Button:FindFirstChildOfClass("UIStroke")
			if st then
				st.Color = Theme.Stroke
			end
			v.ColorBar.BackgroundColor3 = Theme.Accent
			v.Text.TextColor3 = Theme.Text
		end
	end
	for _, f in ipairs(settingsRefreshers) do
		pcall(f)
	end
	if Settings.Effect == "Bubbles" then
		refreshEffect() -- bubbles use the accent colour
	end
end

