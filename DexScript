local crosshairFills = {}
--- (re)builds the crosshair from Settings
local function buildCrosshair()
	for _, c in ipairs(CrosshairFrame:GetChildren()) do
		c:Destroy()
	end
	crosshairFills = {}
	local L, T, G = Settings.CrosshairLength, Settings.CrosshairThickness, Settings.CrosshairGap
	local O = Settings.CrosshairOutline and 1 or 0
	local off = G + L / 2
	local arms = {
		{ Vector2.new(T, L), Vector2.new(0, -off) }, -- top
		{ Vector2.new(T, L), Vector2.new(0, off) }, -- bottom
		{ Vector2.new(L, T), Vector2.new(-off, 0) }, -- left
		{ Vector2.new(L, T), Vector2.new(off, 0) }, -- right
	}
	if Settings.CrosshairDot then
		table.insert(arms, { Vector2.new(T, T), Vector2.new(0, 0) })
	end
	local function part(size, pos, color, transparency, z)
		local f = Instance.new("Frame")
		f.BorderSizePixel = 0
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Size = UDim2.fromOffset(size.X, size.Y)
		f.Position = UDim2.fromOffset(pos.X, pos.Y)
		f.BackgroundColor3 = color
		f.BackgroundTransparency = transparency
		f.ZIndex = z
		f.Parent = CrosshairFrame
		return f
	end
	-- outlines first (behind), then fills on top so overlaps stay clean
	if O > 0 then
		for _, a in ipairs(arms) do
			part(a[1] + Vector2.new(O * 2, O * 2), a[2], Color3.new(0, 0, 0), 0.2, 1)
		end
	end
	for _, a in ipairs(arms) do
		table.insert(crosshairFills, part(a[1], a[2], Color3.new(1, 1, 1), 0, 2))
	end
end
buildCrosshair()

--- the colour the crosshair should be right now
local function crosshairColor()
	if Settings.CrosshairRainbow then
		return Color3.fromHSV((tick() * 0.25) % 1, 0.75, 1)
	end
	if Settings.CrosshairColor == "Accent" then
		return Theme.Accent
	end
	return CrosshairColors[Settings.CrosshairColor] or CrosshairColors.White
end

