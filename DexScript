	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed or listeningForKey or input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		if input.KeyCode.Name == Settings.HideKey then
			SimpleSpy2.Enabled = not SimpleSpy2.Enabled
		end
	end)
)

