--- opens / closes the settings window next to the main window
function toggleSettings()
	if SettingsWindow.Visible then
		SettingsWindow.Visible = false
		return
	end
	local viewport = workspace.CurrentCamera.ViewportSize
	local mainSize = mainWindowSize()
	local x = Background.AbsolutePosition.X + mainSize.X + 8
	if x + 270 > viewport.X then
		x = Background.AbsolutePosition.X - 270 - 8
	end
	local y = math.clamp(Background.AbsolutePosition.Y, 0, math.max(0, viewport.Y - 340))
	SettingsWindow.Position = UDim2.fromOffset(math.max(0, x), y)
	SettingsWindow.Visible = true
end

local settingsButton = newButton("Settings", function()
	return "Themes, background effects, crosshair and more"
end, function()
	toggleSettings()
end)
settingsButton.LayoutOrder = -1 -- show it first

