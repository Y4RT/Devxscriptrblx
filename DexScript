local function randomChar()
	local i = rng:NextInteger(1, #MATRIX_CHARS)
	return MATRIX_CHARS:sub(i, i)
end

local function newParticle(kind, w, h)
	local p = { kind = kind, phase = rng:NextNumber(0, math.pi * 2), vx = 0, vy = 0 }
	local f
	if kind == "Matrix" then
		f = Instance.new("TextLabel")
		f.BackgroundTransparency = 1
		f.Font = Enum.Font.Code
		f.TextSize = rng:NextInteger(11, 15)
		f.TextColor3 = Color3.fromRGB(70, 255, 120)
		f.TextTransparency = rng:NextNumber(0.1, 0.6)
		f.Size = UDim2.fromOffset(12, 14)
		f.Text = randomChar()
		p.timer = rng:NextNumber(0.05, 0.25)
	else
		f = Instance.new("Frame")
		f.BorderSizePixel = 0
	end
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.ZIndex = 10
	p.frame = f
	p.x = rng:NextNumber(0, math.max(w, 1))
	p.y = rng:NextNumber(0, math.max(h, 1))

	if kind == "Snow" then
		local size = rng:NextNumber(2, 5)
		f.Size = UDim2.fromOffset(size, size)
		f.BackgroundColor3 = Color3.new(1, 1, 1)
		f.BackgroundTransparency = rng:NextNumber(0.1, 0.5)
		sCorner(f, 99)
		p.vx = rng:NextNumber(-6, 6)
		p.vy = rng:NextNumber(18, 40) * (size / 3.5)
		p.sway = rng:NextNumber(8, 20)
	elseif kind == "Rain" then
		f.Size = UDim2.fromOffset(1, rng:NextInteger(10, 18))
		f.BackgroundColor3 = Color3.fromRGB(170, 200, 255)
		f.BackgroundTransparency = rng:NextNumber(0.35, 0.65)
		p.vx = 45
		p.vy = rng:NextNumber(380, 560)
		f.Rotation = -math.deg(math.atan2(p.vx, p.vy))
	elseif kind == "Stars" then
		local size = rng:NextInteger(1, 3)
		f.Size = UDim2.fromOffset(size, size)
		f.BackgroundColor3 = Color3.new(1, 1, 1)
		sCorner(f, 99)
		p.vx = rng:NextNumber(1, 4)
		p.twinkle = rng:NextNumber(1, 3)
	elseif kind == "Bubbles" then
		local size = rng:NextInteger(6, 16)
		f.Size = UDim2.fromOffset(size, size)
		f.BackgroundColor3 = Theme.Accent
		f.BackgroundTransparency = 0.85
		sCorner(f, 99)
		local st = sStroke(f, nil, 0.35)
		st.Color = Theme.Accent
		p.vy = -rng:NextNumber(15, 40)
		p.sway = rng:NextNumber(6, 14)
	elseif kind == "Fireflies" then
		f.Size = UDim2.fromOffset(3, 3)
		f.BackgroundColor3 = Color3.fromRGB(255, 225, 120)
		sCorner(f, 99)
		p.vx = rng:NextNumber(-20, 20)
		p.vy = rng:NextNumber(-20, 20)
		p.twinkle = rng:NextNumber(1.5, 3)
	elseif kind == "Sakura" then
		f.Size = UDim2.fromOffset(rng:NextInteger(5, 7), rng:NextInteger(3, 5))
		f.BackgroundColor3 = rng:NextNumber() > 0.5 and Color3.fromRGB(255, 183, 197) or Color3.fromRGB(255, 210, 222)
		f.BackgroundTransparency = rng:NextNumber(0, 0.3)
		sCorner(f, 3)
		p.vx = rng:NextNumber(10, 30)
		p.vy = rng:NextNumber(25, 55)
		p.sway = rng:NextNumber(5, 15)
		p.spin = rng:NextNumber(-120, 120)
	elseif kind == "Matrix" then
		p.x = math.floor(p.x / 12) * 12
		p.vy = rng:NextNumber(70, 160)
	elseif kind == "Confetti" then
		f.Size = UDim2.fromOffset(4, 7)
		f.BackgroundColor3 = Color3.fromHSV(rng:NextNumber(), 0.7, 1)
		p.vx = rng:NextNumber(-20, 20)
		p.vy = rng:NextNumber(60, 120)
		p.sway = rng:NextNumber(10, 25)
		p.spin = rng:NextNumber(90, 360) * (rng:NextNumber() > 0.5 and 1 or -1)
	end
	f.Position = UDim2.fromOffset(p.x, p.y)
	f.Parent = EffectLayer
	return p
end

--- size of the area the effect covers
local function effectAreaSize()
	if Settings.EffectFullscreen then
		return workspace.CurrentCamera.ViewportSize
	end
	return mainWindowSize()
end

--- rebuilds the current effect from Settings
function refreshEffect()
	for _, p in ipairs(particles) do
		p.frame:Destroy()
	end
	particles = {}
	if Settings.EffectFullscreen then
		EffectLayer.Parent = EffectsGui
		EffectLayer.Position = UDim2.new()
		EffectLayer.Size = UDim2.fromScale(1, 1)
	else
		EffectLayer.Parent = Background
		EffectLayer.Position = UDim2.new()
	end
	if Settings.Effect == "None" then
		EffectLayer.Visible = false
		return
	end
	EffectLayer.Visible = true
	local count = Settings.EffectAmount
	if Settings.Effect == "Rain" then
		count *= 1.5
	end
	if Settings.EffectFullscreen then
		count *= 2
	end
	count = math.min(math.floor(count), MAX_PARTICLES)
	local size = effectAreaSize()
	for _ = 1, count do
		table.insert(particles, newParticle(Settings.Effect, size.X, size.Y))
	end
end

table.insert(
	connections,
	RunService.Heartbeat:Connect(function(dt)
		if #particles == 0 then
			return
		end
		if not Settings.EffectFullscreen then
			local sz = mainWindowSize()
			EffectLayer.Size = UDim2.fromOffset(sz.X, sz.Y)
		end
		local w, h = EffectLayer.AbsoluteSize.X, EffectLayer.AbsoluteSize.Y
		local d = dt * Settings.EffectSpeed
		local t = tick()
		for _, p in ipairs(particles) do
			local f = p.frame
			p.x += p.vx * d
			p.y += p.vy * d
			if p.sway then
				p.x += math.sin(t * 1.5 + p.phase) * p.sway * d
			end
			if p.spin then
				f.Rotation += p.spin * d
			end
			if p.kind == "Stars" then
				f.BackgroundTransparency = 0.15 + 0.7 * (0.5 + 0.5 * math.sin(t * p.twinkle + p.phase))
			elseif p.kind == "Fireflies" then
				f.BackgroundTransparency = 0.1 + 0.8 * (0.5 + 0.5 * math.sin(t * p.twinkle + p.phase))
				if rng:NextNumber() < dt * 0.8 then
					p.vx = rng:NextNumber(-20, 20)
					p.vy = rng:NextNumber(-20, 20)
				end
			elseif p.kind == "Matrix" then
				p.timer -= dt
				if p.timer <= 0 then
					p.timer = rng:NextNumber(0.05, 0.25)
					f.Text = randomChar()
				end
			end
			-- wrap around the edges
			if p.y > h + 12 then
				p.y = -12
				p.x = rng:NextNumber(0, math.max(w, 1))
				if p.kind == "Matrix" then
					p.x = math.floor(p.x / 12) * 12
				end
			elseif p.y < -12 then
				p.y = h + 12
				p.x = rng:NextNumber(0, math.max(w, 1))
			end
			if p.x > w + 12 then
				p.x = -12
			elseif p.x < -12 then
				p.x = w + 12
			end
			f.Position = UDim2.fromOffset(p.x, p.y)
		end
	end)
)

